       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "CodeSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://ohs.dev/CodeSystem/view-type-codesystem> ;
         fhir:reference [ fhir:v "CodeSystem/view-type-codesystem" ]
       ] ;
       fhir:name [ fhir:v "UI Component Types (example)" ] ;
       fhir:description [ fhir:v "**Example** vocabulary of view types. Each code names a kind of UI component used to render a piece of\nFHIR-derived data; a ViewConfig binds to one of these codes to select its component. View types are\nimplementer-defined — a player provides its own CodeSystem rather than reusing these codes. The mapping\nfrom a code to a concrete renderer is the player's own implementation detail." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "StructureDefinition:logical"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://ohs.dev/StructureDefinition/ViewConfig> ;
         fhir:reference [ fhir:v "StructureDefinition/ViewConfig" ]
       ] ;
       fhir:name [ fhir:v "View Configuration" ] ;
       fhir:description [ fhir:v "A self-describing UI configuration bound to a view type.\n\n`ViewConfig` is the contract for declaring a config — it does **not** fix any particular config's\nfields. An implementer provides a config as a `ViewConfig` Binary that lists its own `property`\nentries; each property gives a field `name`, its `type`, and a default `value`. A player generates a\ntyped config class from the property list and binds the values to the renderer selected by `viewType`." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "StructureDefinition:logical"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://ohs.dev/StructureDefinition/ViewJoinMap> ;
         fhir:reference [ fhir:v "StructureDefinition/ViewJoinMap" ]
       ] ;
       fhir:name [ fhir:v "View Join Map" ] ;
       fhir:description [ fhir:v "A metadata guide that stitches atomic ViewDefinitions sourced from different\nSearchResult scopes into a single flat JSON row per pivot resource.\n\nThe pivot resource drives the output row count (one row per pivot instance).\nEach join appends its ViewDefinition's columns to the same row. All column\nnames across the pivot and all joins must be unique within this map." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "ValueSet"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://ohs.dev/ValueSet/view-type-vs> ;
         fhir:reference [ fhir:v "ValueSet/view-type-vs" ]
       ] ;
       fhir:name [ fhir:v "View Type ValueSet" ] ;
       fhir:description [ fhir:v "All view type codes a ViewConfig may bind to." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] ) ;
