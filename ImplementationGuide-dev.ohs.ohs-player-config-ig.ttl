       fhir:reference [
         fhir:l <http://ohs.dev/CodeSystem/search-scope-cs> ;
         fhir:reference [ fhir:v "CodeSystem/search-scope-cs" ]
       ] ;
       fhir:name [ fhir:v "Search Scope CodeSystem" ] ;
       fhir:description [ fhir:v "Valid locations within a FHIR Search Result where resources are found.\nUsed by ViewJoinMap to specify where to look for pivot and joined resources." ] ;
